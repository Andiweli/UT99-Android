static UBOOL UT99V50AbsOver( FLOAT V, FLOAT Dead ) { return (V < -Dead || V > Dead); }

static void UT99V50Pulse( UNSDLViewport* Viewport, INT Key, FLOAT AxisDelta=0.0f )
{
    if( !Viewport || Key <= 0 )
        return;

    if( Key == IK_MouseX || Key == IK_MouseY )
    {
        Viewport->CauseInputEvent( (EInputKey)Key, IST_Axis, AxisDelta );
    }
    else
    {
        Viewport->CauseInputEvent( (EInputKey)Key, IST_Press );
        Viewport->CauseInputEvent( (EInputKey)Key, IST_Release );
    }
}

static void UT99V50EdgePulse( UNSDLViewport* Viewport, UBOOL Now, UBOOL& Old, INT Key, const char* Name, FLOAT AxisDelta=0.0f )
{
    if( Now == Old )
        return;
    Old = Now;

    if( Now )
    {
        UT99V50Pulse( Viewport, Key, AxisDelta );
        UT99_ANDROID_SDL_LOGI( "v50 menu/capture %s key=%d axis=%.1f", Name, Key, AxisDelta );
    }
}

static void UT99V50MenuControlsTick( UNSDLViewport* Viewport, UBOOL bMenu )
{
    if( !Viewport || !bMenu )
        return;

    UT99V50EdgePulse( Viewport, GUT99V50BtnA,        GUT99V50OldA,      32, "A/Enter" );
    UT99V50EdgePulse( Viewport, GUT99V50BtnB,        GUT99V50OldB,      67, "B/Duck-C" );
    UT99V50EdgePulse( Viewport, GUT99V50BtnX,        GUT99V50OldX,      69, "X/Use-E" );
    UT99V50EdgePulse( Viewport, GUT99V50BtnY,        GUT99V50OldY,      78, "Y/Next-N" );
    UT99V50EdgePulse( Viewport, GUT99V50BtnL1,       GUT99V50OldL1,      2, "L1/RightMouse" );
    UT99V50EdgePulse( Viewport, GUT99V50BtnR1,       GUT99V50OldR1,      1, "R1/LeftMouse" );
    UT99V50EdgePulse( Viewport, GUT99V50BtnL2,       GUT99V50OldL2,      2, "LTrigger/RightMouse" );
    UT99V50EdgePulse( Viewport, GUT99V50BtnR2,       GUT99V50OldR2,      1, "RTrigger/LeftMouse" );
    UT99V50EdgePulse( Viewport, GUT99V50BtnThumbL,   GUT99V50OldL3,     76, "LStickPush/L" );
    UT99V50EdgePulse( Viewport, GUT99V50BtnThumbR,   GUT99V50OldR3,     82, "RStickPush/R" );

    if( !GUT99V50BtnStart )
        GUT99V50OldStart = 0;
    GUT99V50OldSelect = GUT99V50BtnSelect;

    UT99V50EdgePulse( Viewport, GUT99V50RX < -0.65f, GUT99V50OldRSLeft,  IK_MouseX, "RStickLeft/MouseX", -80.0f );
    UT99V50EdgePulse( Viewport, GUT99V50RX >  0.65f, GUT99V50OldRSRight, IK_MouseX, "RStickRight/MouseX", 80.0f );
    UT99V50EdgePulse( Viewport, GUT99V50RY < -0.65f, GUT99V50OldRSUp,    IK_MouseY, "RStickUp/MouseY", 80.0f );
    UT99V50EdgePulse( Viewport, GUT99V50RY >  0.65f, GUT99V50OldRSDown,  IK_MouseY, "RStickDown/MouseY", -80.0f );

    UT99V50EdgePulse( Viewport, GUT99V50LX < -0.65f, GUT99V50OldLSLeft,  65, "LStickLeft/A" );
    UT99V50EdgePulse( Viewport, GUT99V50LX >  0.65f, GUT99V50OldLSRight, 68, "LStickRight/D" );
    UT99V50EdgePulse( Viewport, GUT99V50LY < -0.65f, GUT99V50OldLSUp,    87, "LStickUp/W" );
    UT99V50EdgePulse( Viewport, GUT99V50LY >  0.65f, GUT99V50OldLSDown,  83, "LStickDown/S" );
}
